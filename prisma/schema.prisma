generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  fullName         String
  email            String   @unique
  password         String
  hotlineNumber    String?
  role             String   @default("consultant") // admin, consultant, operations, finance, marketing, super_admin
  spokenLanguages  Json?    // Array of strings
  nationalities    Json?    // Array of strings
  commissionRate   Float?   @default(0)
  commissionType   String?  @default("10%")
  commissionPaid   Float?   @default(0)
  immigrationBio   String?  @db.Text
  customPermissions Json?   // e.g. { canViewFinance: true }
  visaExpertise    Json?    // Array of strings, e.g. ["DNV", "NLV"]
  isPropertySpecialist Boolean @default(false)
  languages        Json?
  specialties      Json?
  isSenior         Boolean  @default(false)
  maxCapacity      Int      @default(20)
  avatar           String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdById      String?
  creator          User?    @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers     User[]   @relation("UserCreator")

  assignedLeads    Lead[]   @relation("AgentLeads")
  assignedClients  Client[] @relation("AgentClients")
  consultations    Consultation[] @relation("AgentConsultations")
  communicationLogs CommunicationLog[] @relation("AgentCommunications")
  rateHistories      CommissionRateHistory[] @relation("AgentRateHistory")
  rateChangesMade    CommissionRateHistory[] @relation("RateChangesMade")
  reviewedDocuments  Document[]         @relation("DocumentReviewer")
  createdCoupons     DiscountCode[]     @relation("CouponCreator")
  managedProjects    Project[]          @relation("ProjectManager")
  deliveryProjects   Project[]          @relation("DeliveryManager")
  assignedTasks      ProjectTask[]      @relation("AssignedTasks")
  timeLogs           ProjectTimeLog[]   @relation("UserTimeLogs")
  handoverSignoffs   ProjectHandover[]  @relation("HandoverSignoffs")
  respondedReviews   Review[]           @relation("ReviewResponder")

  @@map("users")
}

model Lead {
  id               String   @id @default(uuid())
  firstName        String
  lastName         String
  email            String
  phone            String
  nationality      String?
  countryOfResidence String?
  preferredLanguage String? @default("English")
  serviceType      String?  // DNV, NLV, Business, Study, Tourist, Sworn Translation
  applicantsCount  String?  @default("Main Only")
  source           String?  // FB, IG, Website
  campaignId       String?
  status           String   @default("New Lead")
  notes            String?  @db.Text
  timeline         Json?
  qualificationData Json?
  dependentsDetails Json?
  // Meeting Preference (filled by lead via self-fill form)
  meetingPreferredDate     String?
  meetingPreferredTime     String?   // morning / afternoon / evening
  meetingPreferredLanguage String?
  meetingNotes             String?   @db.Text
  formSubmittedAt          DateTime?
  // Property Investment Service Fields
  preferableArea   String?
  budget           String?
  companyName      String?          @db.VarChar(191)
  dealValue        Decimal?         @db.Decimal(12, 2)
  currency         String           @default("USD") @db.VarChar(10)
  // Translation Service Lead Fields
  sourceLanguage   String?
  targetLanguage   String?
  wordCount        Int?
  aiNotes          String?  @db.Text
  isAiFlagged      Boolean  @default(false)
  flagReason       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignedToId     String?
  assignedTo       User?    @relation("AgentLeads", fields: [assignedToId], references: [id])
  assignedAt       DateTime?
  nextFollowUpDate DateTime?
  
  clientId         String?  @unique
  client           Client?  @relation(fields: [clientId], references: [id])
  consultations    Consultation[]

  @@map("leads")
  @@index([createdAt])
  @@index([companyName])
}


model Client {
  id               String   @id @default(uuid())
  clientCode       String?  @unique // Human-readable ID: "CID 12002"
  firstName        String
  lastName         String
  email            String   @unique
  password         String?
  isTemporaryPassword Boolean @default(true)
  phone            String
  nationality      String?
  countryOfResidence String?
  preferredLanguage String? @default("English")
  serviceType      String?
  packageId        String?
  applicantsCount  String?  @default("Main Only")
  
  status           String   @default("Waiting for Payment")
  visaStatus       String   @default("Not Started")
  documentUploadAllowed Boolean @default(false)
  profileSummary   String?  @db.Text
  dependentsDetails Json?
  caseComments     Json?    // Array of { text, author, authorId, date, time }
  
  sourceLanguage    String?
  targetLanguage    String?
  wordCount         Int?
  
  deviceFingerprint String?
  isBlocked         Boolean  @default(false)
  googleReviewSubmitted Boolean  @default(false)

  // Property Investment Service Fields
  preferableArea   String?
  budget           String?
  aiNotes          String?  @db.Text
  isAiFlagged      Boolean  @default(false)
  flagReason       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignedToId     String?
  assignedTo       User?    @relation("AgentClients", fields: [assignedToId], references: [id])
  assignedAt       DateTime?
  assignedHandlerId   String?
  assignedHandlerName String?
  nextFollowUpDate DateTime?

  lead             Lead?
  documents        Document[]
  payments         Payment[]
  applicationCycles ApplicationCycle[]
  refundRequests   RefundRequest[]
  communications   CommunicationLog[]
  discountCodes    DiscountCode[]
  consultations    Consultation[]
  projects         Project[]

  @@map("clients")
  @@index([createdAt])
}

model Consultation {
  id               String   @id @default(uuid())
  date             String
  timeSlot         String
  durationMinutes  Int      @default(20)
  meetingLink      String?
  zoomMeetingId    String?
  recordingUrl     String?
  status           String   @default("Scheduled") // Scheduled, Completed, NO_SHOW, Cancelled
  
  eligibility      String?  // Eligible, Not Eligible
  recommendedService String?
  recommendedPackageId String?
  internalNotes    String?  @db.Text

  type             String   @default("eligibility") // eligibility, property_guidance, general, follow_up
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  leadId           String?
  lead             Lead?    @relation(fields: [leadId], references: [id])

  clientId         String?
  client           Client?  @relation(fields: [clientId], references: [id])

  consultantId     String?
  consultant       User?    @relation("AgentConsultations", fields: [consultantId], references: [id])
  assignedAt       DateTime?

  @@map("consultations")
}

model ApplicationCycle {
  id               String   @id @default(uuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id])
  
  originalSubmissionDate DateTime?
  refusalDate      DateTime?
  refusalReason    String?  @db.Text
  changesMade      String?  @db.Text
  resubmissionDate DateTime?
  submissionReference String?
  submissionNotes     String?  @db.Text
  submissionReceiptUrl String?
  submittedById       String?
  submittedAt         DateTime?

  lawyerAssigned   String?
  appealSubmissionDate DateTime?
  appealDeadline   DateTime?
  governmentDecision String? @db.Text
  governmentDecisionDate DateTime?

  closureReason    String?  @db.Text
  closedById       String?
  closedAt         DateTime?

  status           String   @default("Resubmission in Progress")
  serviceType      String?
  type             String?  @default("resubmission") // resubmission, appeal
  appealDocuments  Json?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payments         Payment[]
  documents        Document[]
  history          AuditLog[]
  checklistItems   ResubmissionChecklistItem[] @relation("CycleChecklistItems")

  @@map("application_cycles")
}

model Payment {
  id               String   @id @default(uuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id])
  applicationId    String?
  applicationCycle ApplicationCycle? @relation(fields: [applicationId], references: [id])
  
  amount           Float
  discount         Float    @default(0)
  totalPaid        Float    @default(0)
  commissionRate   Float?   @default(0)
  status           String   @default("Pending") // Pending, Paid, Refund Under Review, Refunded
  refundStatus     String?  @default("None") // None, Refund Eligible, Refund Under Review, Refund Approved, Refund Completed, Refund Rejected
  refundEligibility Boolean @default(false)
  refundAmount     Float?   @default(0)
  refundReason     String?  @db.Text
  refundRejectionReason String? @db.Text
  refundProcessedAt DateTime?
  refundProcessedBy String?
  paymentMethod    String?
  transactionId    String?
  gatewayId        String?
  invoiceNumber    String?
  billingDate      DateTime @default(now())
  dueDate          DateTime

  // Genuinely Missing Fields:
  packageType                String?
  paymentPurpose             String?
  additionalApplicants       Int?      @default(0)
  assessmentCreditUsed       Boolean   @default(false)
  creditReservedForPaymentId String?
  creditReservedUntil        DateTime?
  paidAt                     DateTime?
  invoiceSnapshot            Json?
  discountCodeId             String?
  discountCode               String?
  discountPercent            Float?    @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("payments")
}

model ResubmissionChecklistItem {
  id                 String           @id @default(uuid())
  applicationId      String
  applicationCycle   ApplicationCycle @relation("CycleChecklistItems", fields: [applicationId], references: [id])
  
  templateKey        String
  belongsTo          String           @default("Main Applicant")
  category           String
  title              String
  isMandatory        Boolean          @default(true)
  dueDate            DateTime?
  clientInstructions String?          @db.Text
  status             String           @default("MISSING") // MISSING, PENDING_VERIFICATION, VERIFIED, REJECTED, NOT_REQUIRED
  
  sourceDocumentId   String?
  sourceDocument     Document?        @relation("ReusedSourceDocuments", fields: [sourceDocumentId], references: [id])
  
  activeDocumentId   String?          @unique
  activeDocument     Document?        @relation("ActiveChecklistDocument", fields: [activeDocumentId], references: [id])
  
  documents          Document[]       @relation("ChecklistItemVersions")
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([applicationId, templateKey, belongsTo], map: "rci_appId_tmplKey_belongsTo_key")
  @@index([applicationId])
  @@index([status])
  @@index([sourceDocumentId])
  @@map("resubmission_checklist_items")
}

model Document {
  id                      String                     @id @default(uuid())
  clientId                String
  client                  Client                     @relation(fields: [clientId], references: [id])
  applicationId           String?
  applicationCycle        ApplicationCycle?          @relation(fields: [applicationId], references: [id])
  
  checklistItemId         String?
  checklistItem           ResubmissionChecklistItem? @relation("ChecklistItemVersions", fields: [checklistItemId], references: [id])
  
  reusedInChecklistItems  ResubmissionChecklistItem[] @relation("ReusedSourceDocuments")
  activeInChecklistItem   ResubmissionChecklistItem? @relation("ActiveChecklistDocument")
  
  version                 Int                        @default(1)
  name                    String                     @db.Text
  category                String
  url                     String                     @db.Text
  translatedUrl           String?                    @db.Text // URL to download translated PDF
  size                    String?
  status                  String   @default("Pending Verification") // VERIFIED, REJECTED
  comment                 String?  @db.Text

  reviewedById            String?
  reviewedBy              User?                      @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt              DateTime?

  uploadedDate            DateTime @default(now())
  updatedAt               DateTime @updatedAt
  belongsTo               String?  // e.g. "Main Applicant", "Spouse", "Child 1"
  wordCount               Int?     @default(0)

  @@unique([checklistItemId, version])
  @@map("documents")
}

model RefundRequest {
  id              String   @id @default(uuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  
  category        String
  reason          String?  @db.Text
  amount          Float
  status          String   @default("Pending Review") // Pending Review, Approved, Processed, Rejected
  
  proofUrl        String?  // URL of uploaded rejection PDF/Image proof
  bankAccountName String?  // Client Bank Account Holder Name
  bankIban        String?  // IBAN / Account Number
  bankSwift       String?  // SWIFT / BIC Code
  payoutMethod    String?  // "Stripe Automatic" or "Manual Bank Transfer"
  transactionRef  String?  // Stripe Refund ID or Bank UTR Number
  adminNotes      String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("refund_requests")
}

model CompanySetting {
  id                        String   @id @default(uuid())
  companyName               String   @default("AAA Business Consultancy LLC")
  phone                     String   @default("+971 50 955 4142")
  email                     String   @default("info@aaabusinessconsultancy.com")
  address                   String   @default("Business Village, Block B, 4th Floor, Office F09, Deira, Dubai, UAE")
  vatRate                   Float    @default(5)
  vatId                     String   @default("VAT-AE-2026-9932")
  website                   String   @default("https://aaabusinessconsultancy.com")
  incorporationDate         String   @default("2018-05-12")
  autoAssignConsultant      Boolean  @default(true)
  recordingStorage          String   @default("cloud")
  swornTranslationRates      Json?
  leadStages                Json?
  routingRules              Json?
  
  // Master Customization Settings
  refundGuaranteePercentage Float    @default(50)
  enableStripeRefunds       Boolean  @default(true)
  enableManualBankPayouts   Boolean  @default(true)
  lockClientRefundTab       Boolean  @default(true)
  requireMeetingAcceptance  Boolean  @default(true)
  customRefundTerms         String?  @db.Text
  customizationSettings     Json?

  updatedAt                 DateTime @updatedAt

  @@map("company_settings")
}

model VisaService {
  id                   String   @id @default(uuid())
  name                 String
  category             String
  basePrice            Float
  active               Boolean  @default(true)

  @@map("visa_services")
}

model RelocationPackage {
  id                       String   @id @default(uuid())
  code                     String?  @unique
  name                     String
  description              String   @db.Text
  price                    Float
  additionalApplicantPrice Float?   @default(500)
  isRecommended            Boolean  @default(false)
  isFixedPrice             Boolean  @default(false)
  isRefundable             Boolean  @default(false)
  active                   Boolean  @default(true)
  includes                 Json?    // Array of strings
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt

  @@map("relocation_packages")
}

model Template {
  id         String   @id @default(uuid())
  name       String   @default("Template")
  type       String   @default("QUICK_REPLY") // QUICK_REPLY, META_APPROVED, email, whatsapp
  category   String   @default("QUICK_REPLY") // QUICK_REPLY, META_APPROVED
  subject    String?  
  body       String   @db.Text
  contentSid       String?  
  twilioAccountSid String?  
  approvalStatus   String   @default("APPROVED") // APPROVED, PENDING, REJECTED, UNSUBMITTED
  language       String   @default("en")
  active     Boolean  @default(true)
  createdBy  String?  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("templates")
}

model CommunicationLog {
  id                 String   @id @default(uuid())
  clientId           String?
  client             Client?  @relation(fields: [clientId], references: [id])
  phone              String?
  name               String?
  channel            String   // WHATSAPP, EMAIL, MEETING
  direction          String   // INBOUND, OUTBOUND
  messageId          String?  @unique // Deduplication (Meta/WA Message ID)
  externalProviderId String?  
  deliveryStatus     String   // SENT, DELIVERED, FAILED
  readStatus         Boolean  @default(false)
  failureReason      String?  @db.Text
  content            String   @db.Text
  respondedByUserId  String?
  respondedByUser    User?    @relation("AgentCommunications", fields: [respondedByUserId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("communication_logs")
}

model AuditLog {
  id               String   @id @default(uuid())
  leadId           String?
  clientId         String?
  documentId       String?
  applicationId    String?
  applicationCycle ApplicationCycle? @relation(fields: [applicationId], references: [id])
  actorId          String?  // System, User UUID, Client ID, or Webhook ID
  actorName        String?  // e.g., Staff Name, Client Name
  actorRole        String?  // super_admin, admin, consultant, client, system
  action           String?  // e.g., STATUS_CHANGED, DOC_UPLOADED, DOC_VERIFIED, DOC_REJECTED, NOTE_ADDED
  description      String?  @db.Text
  previousState    Json?
  newState         Json?
  createdAt        DateTime @default(now())

  @@map("audit_logs")
}

model MarketingSpend {
  id        String   @id @default(uuid())
  channel   String   @unique
  amount    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("marketing_spend")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String   // recipient: assigned operator's user id
  type        String   @default("new_document") // new_document | general
  title       String
  body        String   @db.Text
  clientId    String?
  documentId  String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("notifications")
}

model ChatSession {
  id               String   @id @default(uuid())
  phone            String   @unique
  currentState     String   @default("START") // START, WAITING_FOR_VISA, WAITING_FOR_APPLICANTS, WAITING_FOR_CUSTOM_APPLICANTS, COMPLETED
  selectedVisa     String?
  applicantsCount  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("chat_sessions")
}

model DiscountCode {
  id               String   @id @default(uuid())
  code             String   @unique
  discountPercent  Float    @default(10)
  expiryDate       DateTime
  isUsed           Boolean  @default(false)
  usedAt           DateTime?
  usedByClientId   String?
  usedInPaymentId  String?

  clientId         String?
  client           Client?  @relation(fields: [clientId], references: [id])

  createdById      String?
  creator          User?    @relation("CouponCreator", fields: [createdById], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([code])
  @@index([isUsed])
  @@index([expiryDate])
  @@map("discount_codes")
}

model AgentSchedule {
  id               String   @id @default(uuid())
  agentId          String
  dayOfWeek        Int      // 0 (Sunday) to 6 (Saturday)
  startTime        String   // e.g. "09:00"
  endTime          String   // e.g. "17:00"

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("agent_schedules")
}

model ReminderLog {
  id               String   @id @default(uuid())
  clientId         String
  type             String   // '2h' | '24h' | '2d' | '5d'
  sentAt           DateTime @default(now())

  @@map("reminder_logs")
}

model BlacklistedClient {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String
  phone            String   @unique
  createdAt        DateTime @default(now())

  @@map("blacklisted_clients")
}

model CommissionRateHistory {
  id              String   @id @default(uuid())
  agentId         String
  agent           User     @relation("AgentRateHistory", fields: [agentId], references: [id])
  oldRate         Float
  newRate         Float
  changedById     String
  changedBy       User     @relation("RateChangesMade", fields: [changedById], references: [id])
  revenueAtChange Float    @default(0)
  createdAt       DateTime @default(now())

  @@map("commission_rate_histories")
}

model Project {
  id                String            @id @default(uuid())
  projectCode       String?           @unique // e.g. "PRJ-2026-001"
  name              String
  description       String?           @db.Text
  serviceType       String?           // "Web Development", "Mobile App", "Cloud & DevOps", "AI / ML", "Cybersecurity", "Custom Software"
  status            String            @default("PLANNING") // PLANNING, IN_PROGRESS, IN_REVIEW, QA_UAT, DEPLOYED, COMPLETED, ON_HOLD, CANCELLED
  priority          String            @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  health            String            @default("ON_TRACK") // ON_TRACK, AT_RISK, DELAYED
  startDate         DateTime?
  deadline          DateTime?
  completedAt       DateTime?
  
  // Budget & Costing
  budget            Float             @default(0)
  spentBudget       Float             @default(0)
  currency          String            @default("USD") // USD, EUR, AED, INR
  
  // Repositories & Environments
  repositoryUrl     String?
  stagingUrl        String?
  productionUrl     String?
  techStack         Json?             // Array of strings e.g. ["React", "Node.js", "AWS"]

  // Client Relation
  clientId          String
  client            Client            @relation(fields: [clientId], references: [id])
  
  // Team Relations
  projectManagerId  String?
  projectManager    User?             @relation("ProjectManager", fields: [projectManagerId], references: [id])
  
  deliveryManagerId String?
  deliveryManager   User?             @relation("DeliveryManager", fields: [deliveryManagerId], references: [id])

  // Sub-entities
  milestones        ProjectMilestone[]
  tasks             ProjectTask[]
  handovers         ProjectHandover[]
  timeLogs          ProjectTimeLog[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("projects")
  @@index([clientId])
  @@index([status])
}

model ProjectMilestone {
  id            String        @id @default(uuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  title         String
  description   String?       @db.Text
  milestoneType String        @default("MILESTONE") // MILESTONE, SPRINT
  status        String        @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, DELAYED
  startDate     DateTime?
  dueDate       DateTime?
  completedAt   DateTime?
  
  tasks         ProjectTask[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("project_milestones")
  @@index([projectId])
}

model ProjectTask {
  id             String            @id @default(uuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  milestoneId    String?
  milestone      ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  
  title          String
  description    String?           @db.Text
  taskType       String            @default("FEATURE") // FEATURE, BUG, TASK, QA, DEPLOYMENT, REFACTOR
  status         String            @default("TODO") // TODO, IN_PROGRESS, IN_REVIEW, QA, UAT, DONE
  priority       String            @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  
  estimatedHours Float             @default(0)
  actualHours    Float             @default(0)
  
  assignedToId   String?
  assignedTo     User?             @relation("AssignedTasks", fields: [assignedToId], references: [id])
  
  dueDate        DateTime?
  completedAt    DateTime?
  
  timeLogs       ProjectTimeLog[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("project_tasks")
  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
}

model ProjectTimeLog {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  taskId      String?
  task        ProjectTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User         @relation("UserTimeLogs", fields: [userId], references: [id])
  
  hours       Float
  workDate    DateTime     @default(now())
  description String?      @db.Text
  isBillable  Boolean      @default(true)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("project_time_logs")
  @@index([projectId])
  @@index([userId])
}

model ProjectHandover {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  stage           String    // QA, UAT, STAGING, PRODUCTION, HANDOVER
  status          String    @default("PENDING") // PENDING, PASSED, REJECTED, SIGNED_OFF
  releaseNotes    String?   @db.Text
  checklist       Json?     // Array of { item: string, passed: boolean, notes: string }
  
  signOffByName   String?
  signOffDate     DateTime?
  
  signedOffById   String?
  signedOffBy     User?     @relation("HandoverSignoffs", fields: [signedOffById], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("project_handovers")
  @@index([projectId])
}

// ==========================================
// REVIEWS & REPUTATION MANAGEMENT (PHASE 3)
// ==========================================

enum ReviewProvider {
  GOOGLE
  META
  CLUTCH
  TRUSTPILOT
  MANUAL
}

enum ReviewSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum ReviewResponseStatus {
  UNRESPONDED
  RESPONDED
  NOT_REQUIRED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum ProviderConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  CONFIG_REQUIRED
  MANUAL_ONLY
}

model Review {
  id               String               @id @default(uuid())
  provider         ReviewProvider
  externalReviewId String?              @db.VarChar(191)
  authorName       String               @default("Anonymous") @db.VarChar(191)
  authorEmail      String?              @db.VarChar(191)
  authorPhotoUrl   String?              @db.Text
  projectType      String?              @db.VarChar(191)
  rating           Int
  reviewText       String?              @db.Text
  reviewDate       DateTime             @default(now())
  sentiment        ReviewSentiment      @default(POSITIVE)
  responseStatus   ReviewResponseStatus @default(UNRESPONDED)
  responseText     String?              @db.Text
  respondedAt      DateTime?
  respondedById    String?              @db.VarChar(191)
  respondedBy      User?                @relation("ReviewResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  status           ReviewStatus         @default(PUBLISHED)
  isDemo           Boolean              @default(false)
  originalUrl      String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([provider, externalReviewId], name: "provider_external_id")
  @@index([provider])
  @@index([rating])
  @@index([sentiment])
  @@index([responseStatus])
  @@index([isDemo])
  @@map("reviews")
}

model ReviewProviderConfig {
  id                 String                   @id @default(uuid())
  provider           ReviewProvider           @unique
  status             ProviderConnectionStatus @default(CONFIG_REQUIRED)
  accountIdentifier  String?                  @db.VarChar(191)
  encryptedApiKey    String?                  @db.Text
  encryptedApiSecret String?                  @db.Text
  autoSyncEnabled    Boolean                  @default(false)
  lastSyncAt         DateTime?
  lastSyncStatus     String?                  @db.VarChar(191)
  lastErrorMessage   String?                  @db.Text
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@map("review_provider_configs")
}
